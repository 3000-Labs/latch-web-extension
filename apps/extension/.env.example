# Latch HTTP API (background fetch). Defaults to Render Go backend if unset.
PLASMO_PUBLIC_LATCH_API_URL=https://latch-backend.onrender.com
# PLASMO_PUBLIC_LATCH_API_URL=https://v0-latch-stellar.vercel.app
# PLASMO_PUBLIC_LATCH_API_URL=http://localhost:3000

# Latch Market HTTP API (prices feed). Defaults to {LATCH_API_URL}/v1 when unset.
# PLASMO_PUBLIC_LATCH_MARKET_API_URL=https://latch-backend.onrender.com/v1

# WebAuthn verifier contract C-address — must match Latch API NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS
# PLASMO_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CDBBGLSWWHWK52REY7GK5HWAQGAJJ4GP5O75LOM3F4INN6W4KT6DPBVY

# Stellar network — "testnet" | "mainnet"
PLASMO_PUBLIC_STELLAR_NETWORK=testnet

# Horizon RPC endpoint
PLASMO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint
PLASMO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional: bundler public G for non-Aquarius swap XDR building only. NOT a secret — BUNDLER_SECRET
# lives only in the Latch API repo. Aquarius swaps use POST /api/transaction/build-swap (API reads BUNDLER_SECRET).
# If set, must match the Latch API bundler public key; omit to avoid stale G mismatches.
# PLASMO_PUBLIC_LATCH_FEE_PAYER_G=G...

# MoonPay publishable key for Fund on-ramp (pk_test_… sandbox or pk_live_…). Not a secret.
# PLASMO_PUBLIC_MOONPAY_API_KEY=pk_test_...
