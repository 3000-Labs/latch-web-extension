# Latch HTTP API (background fetch). Defaults to production if unset.
# PLASMO_PUBLIC_LATCH_API_URL=https://v0-latch-stellar.vercel.app
# PLASMO_PUBLIC_LATCH_API_URL=http://localhost:3000

# Latch Market HTTP API (prices feed). Defaults to production if unset.
# PLASMO_PUBLIC_LATCH_MARKET_API_URL=https://latch-backend.onrender.com/v1

# WebAuthn verifier contract C-address — must match Latch API NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS
# PLASMO_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CDBBGLSWWHWK52REY7GK5HWAQGAJJ4GP5O75LOM3F4INN6W4KT6DPBVY

# Stellar network — "testnet" | "mainnet"
PLASMO_PUBLIC_STELLAR_NETWORK=testnet

# Horizon RPC endpoint
PLASMO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint
PLASMO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
